.kinds { white-space: nowrap; margin-bottom: 20rpx; }
.k {
  display: inline-block;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  color: #4b5563;
}
.k.on { background: #111827; border-color: #111827; color: #fff; }

.undo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  color: #c2410c;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 23rpx;
  margin-bottom: 20rpx;
}
.btn.sm { padding: 10rpx 20rpx; font-size: 22rpx; border-radius: 10rpx; }

.group { margin-bottom: 26rpx; }
.g-head {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8a8f98;
  padding: 0 8rpx 10rpx;
}
.g-head .cnt { color: #c7cbd1; }

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 10rpx;
}
.r-main { flex: 1; min-width: 0; }
.r-date { font-size: 26rpx; font-weight: 600; display: block; }
.r-meta { font-size: 22rpx; color: #8a8f98; margin-top: 4rpx; display: block; }
