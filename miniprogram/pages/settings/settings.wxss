.panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f2f4;
}
.item:last-child { border-bottom: none; }
.lbl { font-size: 28rpx; }
.hint-line { display: block; font-size: 21rpx; color: #9ca3af; margin-top: 6rpx; line-height: 1.5; }
.val { font-size: 26rpx; color: #6b7280; }
.arrow { color: #c7cbd1; font-size: 32rpx; }

.foot { text-align: center; margin-top: 40rpx; }
.foot text { display: block; font-size: 21rpx; color: #9ca3af; line-height: 1.8; }
.foot .ver { margin-top: 10rpx; color: #c7cbd1; }
