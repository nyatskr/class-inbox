.c-done { color: #047857; }
.c-pending { color: #c2410c; }
.c-none { color: #8a8f98; }

.tags { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.detail { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f1f2f4; }
.row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 14rpx; }
.btn.sm { padding: 12rpx 22rpx; font-size: 24rpx; border-radius: 12rpx; }

.ta {
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}
.note { font-size: 22rpx; color: #9ca3af; line-height: 1.6; }
